PORT=5000
NODE_ENV=development

# Database Settings
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=eventhub

# Redis Settings
REDIS_URL=redis://localhost:6379

# JWT Secrets
JWT_SECRET=super_secret_jwt_access_key_2026
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_2026

# CORS Origin
CORS_ORIGIN=http://localhost:3000

# AWS S3 Settings (Set S3_MOCK=false to use real S3)
S3_MOCK=true
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your-eventhub-posters-bucket

# Email Settings (Set EMAIL_MOCK=false to send real emails via SMTP/SES)
EMAIL_MOCK=true
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@eventhub.com
